RS_USERNAME=your_username_or_id
RS_PASSWORD=your_password

# Use  @BotFather for creating new bot
# @userinfobot - for getting ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Google Sheets journal
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# Optional runtime paths
RS_SESSION_STORAGE_PATH=./session_state.json
# Root for temporary screenshots and explicitly retained evidence
RS_SCREENSHOTS_DIR=./screenshots
RS_SCREENSHOTS_TMP_DIR=./screenshots/tmp
RS_EVIDENCE_DIR=./screenshots/evidence
# Safety lock: keep false until the final-submit live smoke is explicitly approved.
RSGE_ENABLE_SUBMISSION=false
# Required before enabling submission. Generate with: openssl rand -base64 32
RSGE_EVIDENCE_KEY=base64_encoded_32_byte_key
LOGS_DIR=./logs
AUDIT_LOG_PATH=./logs/audit.jsonl

# Runtime retention defaults
LOG_MAX_SIZE_MB=10
LOG_ROTATION_HOURS=24
LOG_RETENTION_DAYS=14
LOG_MAX_TOTAL_SIZE_MB=100
SCREENSHOT_TTL_HOURS=24
SCREENSHOT_MAX_SIZE_MB=250
CLEANUP_INTERVAL_MINUTES=60

# Docker stdout/stderr rotation
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
